# Allowlist: never send inventory, workbooks, URLs, credentials or image uploads to Docker.
**
!Dockerfile
!.dockerignore
!backend/
!backend/**
!frontend/
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/index.html
!frontend/tsconfig.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!scripts/
!scripts/container_entrypoint.py
!scripts/container_healthcheck.py
!docs/
!docs/power-automate/
!docs/power-automate/InventoryOperations.ts
**/__pycache__/**
**/*.pyc
**/.env*
frontend/src/**/*.test.*
frontend/node_modules
frontend/dist
frontend/*.tsbuildinfo
**/__pycache__
**/.DS_Store
